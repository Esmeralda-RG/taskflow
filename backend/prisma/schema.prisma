generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  role        Role      @default(EXECUTOR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectsAsMember ProjectMember[]
  comments        Comment[]
  timeLogs        TaskTimeLog[]
  assignedTasks   Task[]        @relation("TaskAssignee")

  @@map("users")
}

enum Role {
  ADMIN
  LEADER
  EXECUTOR
}

enum CommentInteraction {
  APROBADO
  DESAPROBADO
  DUDA
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  phases      Phase[]
  members     ProjectMember[]
  tasks       Task[]

  @@map("projects")
}

model Phase {
  id          String    @id @default(cuid())
  name        String
  order       Int
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks       Task[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, name])
  @@map("phases")
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      String      @default("Por hacer")
  estimatedHours Int?
  startDate   DateTime?
  endDate     DateTime?
  phaseId     String
  projectId   String
  assigneeId  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  phase       Phase       @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments    Comment[]
  timeLogs    TaskTimeLog[]
  attachments Attachment[]

  @@map("tasks")
}

model Comment {
  id          String             @id @default(cuid())
  content     String
  interaction CommentInteraction
  taskId      String
  userId      String
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id])
  attachments Attachment[]

  createdAt DateTime @default(now())

  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  taskId    String
  commentId String?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("attachments")
}

model TaskTimeLog {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  timeSpent   Int      // minutos
  description String?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())

  @@map("task_time_logs")
}
